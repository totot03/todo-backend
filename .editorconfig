# ─────────────────────────────────────────────
# 에디터 공통 규칙 (IntelliJ/STS/VS Code 가 네이티브로 인식)
# Prettier 가 닿지 않는 영역(Java, XML, properties)까지 커버한다.
# ─────────────────────────────────────────────
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java / Maven — 4칸 들여쓰기 관례
[*.java]
indent_size = 4

[*.{xml,pom}]
indent_size = 4

[*.{properties,yml,yaml}]
indent_size = 2

# Markdown — 줄 끝 공백 2개가 줄바꿈 문법이므로 제거하지 않는다
[*.md]
trim_trailing_whitespace = false

# Windows 배치 파일은 CRLF
[*.{bat,cmd}]
end_of_line = crlf
