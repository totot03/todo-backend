# /etc/todolist/todolist.env 템플릿
#
# 이 파일 자체(.example 없는 실제 todolist.env)는 git 저장소 어디에도 존재하지 않는다.
# 사용법:
#   1) 이 파일을 복사해 <실제값> 부분을 채운다 (파일명에서 .example 제거)
#   2) WinSCP로 /home/ec2-user/todolist.env 에 임시 업로드
#   3) install.sh가 /etc/todolist/todolist.env 로 옮기고 root:ec2-user 640 권한을 적용한 뒤
#      홈 디렉토리의 임시 파일은 삭제한다.
#
# application.properties/application-prod.properties가 ${ENV_VAR} 형태로 참조하는 값만 채우면 된다.
# (테스트 프로필은 이 파일과 무관하게 application-test.properties에 더미 값이 고정돼 있다.)

SPRING_PROFILES_ACTIVE=prod

# --- Database (RDS PostgreSQL, database: todolist_db) ---
DB_URL=jdbc:postgresql://todolistdb.cfy4ick209li.ap-northeast-2.rds.amazonaws.com/todolist_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# --- JWT ---
JWT_SECRET=CHANGE_ME

# --- CORS ---
# app.cors.allowed-origins가 비어 있으면 CorsConfig의 @Value 주입이 실패해 애플리케이션 기동
# 자체가 안 되므로, 프론트 도메인이 확정되기 전이라도 임시 값을 채워둬야 한다.
CORS_ALLOWED_ORIGINS=<프론트 도메인, 예: https://app.example.com>

# --- Google OAuth2 ---
# 구글 클라우드 콘솔의 "승인된 리디렉션 URI"는 Spring Security 기본값
# ({baseUrl}/login/oauth2/code/google)을 그대로 쓰며 이 env 파일과는 무관하다.
# CloudFront 등 리버스 프록시 뒤에 두는 경우, {baseUrl}이 프록시 도메인 기준으로 계산되려면
# server.forward-headers-strategy=framework가 필요하다(application-prod.properties에 이미 포함).
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# 로그인/회원가입 성공 시 백엔드가 쿠키를 심은 뒤 프론트로 리다이렉트할 경로(구글 OAuth2 로그인 전용,
# 이메일 로그인은 리다이렉트 없이 JSON으로 응답한다 — AuthController 참고).
# app/oauth2/callback/page.tsx가 성공 경로를, /login?error=oauth가 실패 경로를 받는다(프론트 고정 라우트).
OAUTH2_SUCCESS_REDIRECT_URI=<프론트 도메인>/oauth2/callback
OAUTH2_FAILURE_REDIRECT_URI=<프론트 도메인>/login?error=oauth

# --- S3 (파일 저장) ---
# file.storage.type을 s3로 바꿔야 LocalFileStorageService 대신 S3FileStorageService가 뜬다.
FILE_STORAGE_TYPE=s3
# 공통 application.properties 기본값(todolist-dev-tx7676 / ap-northeast-2)과 동일하면 생략해도
# 되지만, 운영 설정을 한눈에 보기 위해 명시적으로 남긴다.
AWS_S3_BUCKET=todolist-dev-tx7676
AWS_REGION=ap-northeast-2

# --- AWS 자격증명은 여기에 두지 않는다 ---
# EC2에 연결된 IAM Role을 SDK의 DefaultCredentialsProvider(S3Config.java)가 자동으로
# 사용한다. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY는 설정하지 않는다.
# IAM Role 연결 여부 확인: curl -s http://169.254.169.254/latest/meta-data/iam/security-credentials/
# (역할 이름이 출력되면 정상. deploy/iam/s3-policy.json 참고. presigned URL 서명에도 같은 자격증명을
# 쓰므로 GetObject 권한이 반드시 포함돼 있어야 한다.)

# --- 인증 쿠키(app.cookie.secure / app.cookie.same-site)는 여기서 설정하지 않는다 ---
# 운영값(Secure=true, SameSite=None)이 application-prod.properties에 고정돼 있다 —
# 프론트(Amplify)와 백엔드(CloudFront)가 서로 다른 도메인인 cross-site 구조에서 값이 흔들리면
# 로그인 자체가 깨지므로 환경변수로 빼지 않았다.
